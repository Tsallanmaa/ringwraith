{
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/ringwraith *)",
      "Bash(.venv/Scripts/ringwraith.exe *)",
      "Bash(.venv/Scripts/ringwraith)",
      "Read(//c/Users/you/Documents/Ringwraith/**)",
      "Edit(//c/Users/you/Documents/Ringwraith/**)"
    ],
    "additionalDirectories": [
      "C:/Users/you/Documents/Ringwraith"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/ringwraith.exe\" status --hook 2>/dev/null || true",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
